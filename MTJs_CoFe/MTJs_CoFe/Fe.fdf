# ---------------------------------------------------------------------------
# Name and Label
# ---------------------------------------------------------------------------

SystemName          Fe
SystemLabel         Fe

# ---------------------------------------------------------------------------
# Lattice
# ---------------------------------------------------------------------------

LatticeConstant             1.00 Ang

%block LatticeVectors
    4.045000    0.000000    0.000000
    0.000000    4.045000    0.000000
    0.000000    0.000000    11.440988
%endblock LatticeVectors

# ---------------------------------------------------------------------------
# Species and Atoms
# ---------------------------------------------------------------------------

NumberOfSpecies        5
NumberOfAtoms          16

%block ChemicalSpeciesLabel
    1    32    Ge
    2    26    Fe
    3    12    Mg
    4    8    O
    5    25    Mn
%endblock ChemicalSpeciesLabel

# ---------------------------------------------------------------------------
# Atomic Coordinates
# ---------------------------------------------------------------------------

AtomicCoordinatesFormat Ang

%block AtomicCoordinatesAndAtomicSpecies
    1.01125000    1.01125000    0.00000000    2
    3.03375000    3.03375000    0.00000000    2
    3.03375000    1.01125000    1.43012350    2
    1.01125000    3.03375000    1.43012350    2
    1.01125000    1.01125000    2.86024700    2
    3.03375000    3.03375000    2.86024700    2
    3.03375000    1.01125000    4.29037050    2
    1.01125000    3.03375000    4.29037050    2
    3.03375000    3.03375000    5.72049400    2
    1.01125000    1.01125000    5.72049400    2
    3.03375000    1.01125000    7.15061750    2
    1.01125000    3.03375000    7.15061750    2
    3.03375000    3.03375000    8.58074100    2
    1.01125000    1.01125000    8.58074100    2
    3.03375000    1.01125000    10.01086450    2
    1.01125000    3.03375000    10.01086450    2
%endblock AtomicCoordinatesAndAtomicSpecies


%block DM.InitSpin
    1    2.200
    2    2.200
    3    2.200
    4    2.200
    5    2.200
    6    2.200
    7    2.200
    8    2.200
    9    2.200
    10    2.200
    11    2.200
    12    2.200
    13    2.200
    14    2.200
    15    2.200
    16    2.200
%endblock DM.InitSpin


%block PAO.Basis
Mg 2
n=3 0 2 E 40 -0.9
9.63181714792 5.7465000
n=3 1 1 E 40 -0.9 Q .9060565 .0100000
9.63181714792
%endblock PAO.Basis


# ----------------------------------------------------------------------------
# K-Points Grid (Monkhorst-Pack)
# ----------------------------------------------------------------------------
%block kgrid_Monkhorst_Pack
     12  0  0  0.0    # k-points along a
     0  12  0  0.0    # k-points along b
     0  0   100  0.0    # k-points along c
%endblock kgrid_Monkhorst_Pack

# ----------------------------------------------------------------------------
# Geometry Constraints
# ----------------------------------------------------------------------------
%block Geometry.Constraints
    position from 1 to 16
%endblock Geometry.Constraints
# ----------------------------------------------------------------------------
# Basis and Pseudopotential Settings
# ----------------------------------------------------------------------------
PAO.EnergyShift       0.01 eV
PAO.BasisSize         TZP

# ----------------------------------------------------------------------------
# Exchange-Correlation Functional
# ----------------------------------------------------------------------------
XC.functional         GGA
XC.authors            PBE
# ----------------------------------------------------------------------------
# Spin and Solution Settings
# ----------------------------------------------------------------------------
SpinPolarized         .true.

# ----------------------------------------------------------------------------
# Mesh and Temperature Settings
# ----------------------------------------------------------------------------
MeshCutoff            600 Ry
ElectronicTemperature 0.1 eV

# ----------------------------------------------------------------------------
# Density Matrix Mixing
# ----------------------------------------------------------------------------
DM.MixingWeight       0.01
DM.NumberPulay        25
DM.UseSaveDM          .true.
UseSaveData           .true.
SaveRho               .true.
SaveHS                .true.
TS.HS.Save            .true.


SolutionMethod diagon


# ----------------------------------------------------------------------------
# Molecular Dynamics Settings
# ----------------------------------------------------------------------------
MD.TypeOfRun          Fire
MD.NumCGsteps         100
MD.VariableCell       .true.
MD.MaxStressTol       0.5 GPa
MD.MaxForceTol        0.01 eV/Ang
MD.MaxCGDispl         0.01 Ang
MD.Forces.Stress      .true.
MD.MaxStressTol   0.1  eV/Ang**3
# ----------------------------------------------------------------------------
# Output Settings
# ----------------------------------------------------------------------------
WriteCoorXmol         .true.
WriteCoorStep         .true.
WriteForces           .true.
WriteHirshfeldPop     .true.
WriteVoronoiPop       .true.

# ----------------------------------------------------------------------------
# Parallelization
# ----------------------------------------------------------------------------
Diag.ParallelOverK    .true.
