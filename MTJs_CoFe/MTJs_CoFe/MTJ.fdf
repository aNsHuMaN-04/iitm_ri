# ----------------------------------------------------------------------------
# K-Points Grid (Monkhorst-Pack)
# ----------------------------------------------------------------------------
%block kgrid_Monkhorst_Pack
     13  0  0  0.0    # k-points along a
     0  13  0  0.0    # k-points along b
     0  0   1  0.0    # k-points along c
%endblock kgrid_Monkhorst_Pack

# ----------------------------------------------------------------------------
# Geometry Constraints
# ----------------------------------------------------------------------------
%block Geometry.Constraints
    position from 9 to 24
    position from 129 to 136
    position from 1 to 144 1. 0. 0.
    position from 1 to 144 0. 1. 0.
%endblock Geometry.Constraints

# ----------------------------------------------------------------------------
# Basis and Pseudopotential Settings
# ----------------------------------------------------------------------------
PAO.EnergyShift       0.05 eV
PAO.BasisSize         TZP

# ----------------------------------------------------------------------------
# Exchange-Correlation Functional
# ----------------------------------------------------------------------------
XC.functional         GGA
XC.authors            PBE

# ----------------------------------------------------------------------------
# Spin and Solution Settings
# ----------------------------------------------------------------------------
SpinPolarized         .true.
#SolutionMethod diagon

SpinPolarized         .true.
SolutionMethod ELSI
ELSI.Solver ELPA
ELSI.ELPA.NSinglePrecision 00
# ----------------------------------------------------------------------------
# Mesh and Temperature Settings
# ----------------------------------------------------------------------------
# Explicit FFT grid (overrides MeshCutoff)
Mesh.Sizes [ 96 96 1536]
Mesh.SubDivisions 2


ElectronicTemperature 0.1 eV
SCF.H.Tolerance   0.01 eV
SCF.DM.Tolerance  0.01 eV
SCF.Mixer.Restart = 50
SCF.Mixer.Restart.Save = 0
# ----------------------------------------------------------------------------
# Density Matrix Mixing
# ----------------------------------------------------------------------------
DM.MixingWeight       0.02
DM.NumberPulay        22
DM.UseSaveDM          .true.
UseSaveData           .true.
SaveRho               .true.
SaveHS                .true.
TS.HS.Save            .true.

# ----------------------------------------------------------------------------
# Molecular Dynamics Settings
# ----------------------------------------------------------------------------
MD.TypeOfRun          Fire
MD.NumCGsteps         100
MD.VariableCell       .false.
MD.MaxForceTol        0.01 eV/Ang
MD.MaxCGDispl         0.005 Ang
MD.Forces.Stress      .true.

# ----------------------------------------------------------------------------
# Output Settings
# ----------------------------------------------------------------------------
MD.Forces.Stress true
SaveRho        .true.
DM.UseSaveDM    true
UseSaveData     true
WriteCoorStep           .true.
WriteForces             .true.
WriteCoorXmol           .true. 
SaveHS                  true
TS.HS.Save              true

SaveDeltaRho                 true
SaveElectrostaticPotential   true
SaveTotalCharge              true
SaveTotalPotential           true
SaveIonicCharge              true
WriteHirshfeldPop            true
WriteVoronoiPop              true

# ----------------------------------------------------------------------------
# Parallelization
# ----------------------------------------------------------------------------
Diag.ParallelOverK    .true.

